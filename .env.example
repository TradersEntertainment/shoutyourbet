# --- LiveKit (https://cloud.livekit.io -> Settings -> Keys) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- API ---
API_PORT=4000
# live = Binance WS + Yahoo polling, mock = random walk with pumps/dumps (offline dev)
PRICE_MODE=mock
# mock mode only: >1 makes prices swing harder (demos)
MOCK_VOLATILITY=1
# how long until a LONG/SHORT shout is scored (seconds)
SHOUT_HORIZON_SEC=900
# enables /debug/* endpoints
DEV_TOOLS=1

# --- $SHOUT economy (optional; without these the app runs without wallets/rewards) ---
# Postgres (Railway Postgres / Supabase). Local: postgresql://user@localhost:5432/shoutyourbet
DATABASE_URL=
# long random string, signs wallet sessions:  openssl rand -hex 32
SESSION_SECRET=
# devnet | mainnet-beta | localnet
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# printed by: pnpm --filter @syb/api token:create
SHOUT_MINT=
SOLANA_TREASURY_SECRET=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
